      "inputParameters": {
        "payload": {
          "configPath": "${workflow.input.configPath}",
          "runDir": "${workflow.input.runDir}",
          "stage": "init",
          "storyPath": "${workflow.input.storyPath}"
        }
      },
      "name": "insomnia_media_pipeline_init",
      "taskReferenceName": "stage_init",
      "type": "SIMPLE"
    },
